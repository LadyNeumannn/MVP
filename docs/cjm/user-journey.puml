@startuml user-journey
title CJM: пользователь оформляет заказ в Авито.Кухня

start

:Открывает раздел "Авито.Кухня";
:GET /api/v1/restaurants\nсписок доступных заведений;

if (Есть активные заведения рядом?) then (нет)
  :Показать пустое состояние\n"Заведений пока нет";
  stop
else (да)
endif

if (Ищет конкретное блюдо/кухню?) then (да)
  :Вводит запрос в поиск;
  :GET /api/v1/restaurants?q=...\nфильтр заведений по названию;
  if (Поиск ничего не нашёл?) then (да)
    :Показать "Ничего не найдено",\nпредложить сбросить фильтр;
    stop
  else (нет)
  endif
else (нет)
endif

:Выбирает заведение;
:GET /api/v1/restaurants/{id}/menu\nполучает меню;

if (В меню есть доступные позиции?) then (нет)
  :Показать "Меню временно недоступно";
  stop
else (да)
endif

if (Ищет конкретную позицию в меню?) then (да)
  :GET .../menu?q=...\nфильтр позиций по названию;
else (нет)
endif

:Добавляет позиции в корзину;

repeat
  :Меняет состав корзины;
repeat while (Хочет продолжить редактирование?) is (да)
->нет;

:Вводит имя, телефон\nи адрес доставки;

if (Заполнены имя, телефон и адрес?) then (нет)
  :422: показать, какое поле\nне заполнено;
  stop
else (да)
endif

:Оформляет заказ\nPOST /api/v1/orders;
note right
  Заголовок Idempotency-Key защищает от
  случайного дубля при двойном клике или
  повторе запроса на нестабильной сети —
  повтор вернёт тот же заказ, а не создаст новый.
end note

if (Все позиции ещё доступны\nи принадлежат заведению?) then (нет)
  :409 Conflict:\n"Часть позиций недоступна";
  :Показать, какие позиции исчезли\nиз меню, предложить обновить корзину;
  stop
else (да)
endif

if (Заведение всё ещё активно?) then (нет)
  :404/409:\n"Заведение временно не принимает заказы";
  stop
else (да)
endif

:Заказ создан, статус "created";
:Показать номер заказа и итоговую сумму;

:Периодически GET /api/v1/orders/{id}\nотслеживает статус;

partition "Статусы заказа" {
  :created;
  :confirmed — заведение приняло заказ;
  :preparing — готовится;
  :ready — готов;
  :delivered — заказ завершён;
}

if (Заведение отменило заказ?) then (да)
  :Статус "cancelled",\nпоказать причину;
  stop
else (нет)
endif

:Пользователь получает заказ;
stop

@enduml
